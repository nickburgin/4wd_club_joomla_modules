<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" hint="COM_GAFINANCE_SEARCH_FILTER_SUBMIT"
               label="COM_GAFINANCE_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="list"
               label="COM_CONTENT_FILTER_STATE"
               description="COM_CONTENT_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="0"> - Select Status - </option>
            <option value="5">Prepared Only</option>
            <option value="4">PDF Created</option>
            <option value="3">Waiting Payment</option>
            <option value="2">Completed (Paid)</option>
            <option value="7">Completed (Archived)</option>
            <option value="1">JPUBLISHED</option>
            <option value="6">Cancelled</option>
        </field>

    </fields>

    <fields name="list">

        <field name="limit"
               type="limitbox"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>