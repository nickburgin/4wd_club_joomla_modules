<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="GlennArkell\Component\Gafinance\Administrator\Field">
	<fieldset name="sysinfo">
		<field name="id" type="text" readonly="true" class="readonly" default="0" label="COM_GAFINANCE_FORM_LBL_ID" description="COM_GAFINANCE_FORM_DESC_ID"/>
		<field name="ordering" label="COM_GAFINANCE_FORM_LBL_ORDERING" description="COM_GAFINANCE_FORM_DESC_ORDERING"/>
		<field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="checked_out" type="hidden" filter="unset"/>
		<field name="checked_out_time" type="hidden" filter="unset"/>
	    <field name="created_by" type="Createdby" hidden="true" default="0" label="COM_GAFINANCE_FORM_LBL_CREATED_BY" description="COM_GAFINANCE_FORM_DESC_CREATED_BY" hint="COM_GAFINANCE_FORM_LBL_CREATED_BY"/>
	    <field name="modified_by" type="Modifiedby" hidden="true" default="0" label="COM_GAFINANCE_FORM_LBL_MODIFIED_BY" description="COM_GAFINANCE_FORM_DESC_MODIFIED_BY" hint="COM_GAFINANCE_FORM_LBL_MODIFIED_BY"/>
	    <field name="created_date" type="Timecreated" label="COM_GAFINANCE_FORM_LBL_CREATED_DATE" description="COM_GAFINANCE_FORM_DESC_CREATED_DATE" hint="COM_GAFINANCE_FORM_LBL_CREATED_DATE"/>
	    <field name="modified_date" type="Timecreated" label="COM_GAFINANCE_FORM_LBL_MODIFIED_DATE" description="COM_GAFINANCE_FORM_DESC_MODIFIED_DATE" hint="COM_GAFINANCE_FORM_LBL_MODIFIED_DATE"/>
	</fieldset>

	<fieldset name="general">

        <field name="asset_name" type="text" required="true" filter="safehtml"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_ASSET_NAME"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_ASSET_NAME" />

        <field name="cat_id" type="category" extension="com_gafinance.asset" show_root="false"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_CAT_ID"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_CAT_ID" />

        <field name="asset_desc" type="editor" filter="safehtml" height="250px"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_ASSET_DESC"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_ASSET_DESC" />

        <field name="model_no" type="text" filter="safehtml"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_MODEL_NO"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_MODEL_NO" />

        <field name="serial_no" type="text" filter="safehtml"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_SERIAL_NO"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_SERIAL_NO" />

        <field name="asset_date" type="calendar" required="true" default="NOW"
            filterFormat="Y-m-d" translateformat="true"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_ASSET_DATE"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_ASSET_DATE" />

        <field name="asset_value" type="text" default="0.00" required="true" filter="safehtml"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_ASSET_VALUE"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_ASSET_VALUE" />

        <field name="asset_img" type="media" directory="finances/assets/images"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_ASSET_IMG"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_ASSET_IMG" />

        <field name="asset_manual" type="media" directory="finances/assets/manuals"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_ASSET_MANUAL"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_ASSET_MANUAL" />

        <field name="depreciate" type="radio" layout="joomla.form.field.radio.switcher" required="true" default="0"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_DEPRECIATE"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_DEPRECIATE">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="dep_period" type="text" filter="safehtml" showon="depreciate:1" default="YEAR"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_DEP_PERIOD"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_DEP_PERIOD" />

        <field name="dep_term" type="text" filter="safehtml" showon="depreciate:1"
            label="COM_GAFINANCE_FORM_LBL_BUSASSET_DEP_TERM"
            description="COM_GAFINANCE_FORM_DESC_BUSASSET_DEP_TERM" />

	</fieldset>

	<fieldset name="extrainfo">
		<field name="comment" filter="safehtml" type="textarea" label="COM_GAFINANCE_FORM_LBL_COMMENT" description="COM_GAFINANCE_FORM_DESC_COMMENT" hint="COM_GAFINANCE_FORM_LBL_COMMENT"/>
	</fieldset>

	<fieldset name="other">
		<field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
	</fieldset>
</form>
