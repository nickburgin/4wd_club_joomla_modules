<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter" addfieldprefix="GlennArkell\Component\Gausers\Administrator\Field">
        <field name="search" type="text" hint="COM_GAUSERS_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

		<field name="state"
			type="list" default=""
			label="COM_GAUSERS_FILTER_STATE"
			description="COM_GAUSERS_FILTER_STATE_DESC"
			onchange="this.form.submit();" >
			<option value="">GAOPTION_SELECT</option>
			<option value="2">GAOPTION_PAID</option>
			<option value="1">GAOPTION_UNPAID</option>
			<option value="-2">GAOPTION_CANCELLED</option>
		</field>

        <field name="pay_type" type="category" extension="com_gausers.payment"
			onchange="this.form.submit();" show_root="true"
            label="COM_GAUSERS_FORM_LBL_INVOICE_PAY_TYPE"
            description="COM_GAUSERS_FORM_DESC_INVOICE_PAY_TYPE" />

    </fields>

	<fields name="list">

		<field name="limit"
			type="limitbox"
			class="input-mini"
			default="25"
			onchange="this.form.submit();" />

	</fields>

</form>