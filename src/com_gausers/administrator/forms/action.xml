<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="sysinfo" addfieldprefix="GlennArkell\Component\Gausers\Administrator\Field">
		<field name="id" type="text" readonly="true" class="readonly" default="0" label="COM_GAUSERS_FORM_LBL_ID" description="COM_GAUSERS_FORM_DESC_ID"/>
		<field name="ordering" label="COM_GAUSERS_FORM_LBL_ORDERING" description="COM_GAUSERS_FORM_DESC_ORDERING"/>
		<field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="checked_out" type="hidden" filter="unset"/>
		<field name="checked_out_time" type="hidden" filter="unset"/>
	    <field name="created_by" type="Createdby" hidden="true" default="0" label="COM_GAUSERS_FORM_LBL_CREATED_BY" description="COM_GAUSERS_FORM_DESC_CREATED_BY" hint="COM_GAUSERS_FORM_LBL_CREATED_BY"/>
	    <field name="modified_by" type="Modifiedby" hidden="true" default="0" label="COM_GAUSERS_FORM_LBL_MODIFIED_BY" description="COM_GAUSERS_FORM_DESC_MODIFIED_BY" hint="COM_GAUSERS_FORM_LBL_MODIFIED_BY"/>
	    <field name="created_date" type="Timecreated" label="COM_GAUSERS_FORM_LBL_CREATED_DATE" description="COM_GAUSERS_FORM_DESC_CREATED_DATE" hint="COM_GAUSERS_FORM_LBL_CREATED_DATE"/>
	    <field name="modified_date" type="Timecreated" label="COM_GAUSERS_FORM_LBL_MODIFIED_DATE" description="COM_GAUSERS_FORM_DESC_MODIFIED_DATE" hint="COM_GAUSERS_FORM_LBL_MODIFIED_DATE"/>
	</fieldset>

	<fieldset name="general" addfieldprefix="GlennArkell\Component\Gausers\Administrator\Field">

        <field name="user_id" type="user"
            label="COM_GAUSERS_FORM_LBL_ACTION_USER_ID"
            description="COM_GAUSERS_FORM_DESC_ACTION_USER_ID" />

        <field name="act_name" type="text" class="inputbox" filter="safehtml"
            label="COM_GAUSERS_FORM_LBL_ACTION_ACT_NAME"
            description="COM_GAUSERS_FORM_DESC_ACTION_ACT_NAME" />

		<field name="category_id" type="category" extension="com_gausers.actions"
			description="COM_GAUSERS_FORM_DESC_ACTION_CAT_ID"
			label="COM_GAUSERS_FORM_LBL_ACTION_CAT_ID" />

	</fieldset>

	<fieldset name="extrainfo">
		<field name="comment" filter="safehtml" type="textarea" label="COM_GAUSERS_FORM_LBL_COMMENT" description="COM_GAUSERS_FORM_DESC_COMMENT" hint="COM_GAUSERS_FORM_LBL_COMMENT"/>
		<field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
	</fieldset>

</form>
