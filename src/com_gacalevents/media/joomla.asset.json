      "uri": "com_gacalevents/gacalevents.css",
      "dependencies": [
        "fontawesome"
      ]
    },
    {
      "name": "com_gacalevents.item",
      "description": "Glenn's Component styling for an item.",
      "type": "style",
      "uri": "com_gacalevents/item.css",
      "dependencies": [
        "com_gacalevents.gacalevents"
      ]
    },
    {
      "name": "com_gacalevents.list",
      "description": "Glenn's Component styling for a list.",
      "type": "style",
      "uri": "com_gacalevents/list.css",
      "dependencies": [
        "com_gacalevents.gacalevents"
      ]
    },
    {
      "name": "com_gacalevents.form",
      "description": "Glenn's Component styling for a form.",
      "type": "style",
      "uri": "com_gacalevents/form.css",
      "dependencies": [
        "com_gacalevents.gacalevents"
      ]
    },
    {
      "name": "com_gacalevents.gacaleventspreset",
      "type": "preset",
      "dependencies": [
        "com_gacalevents.gacalevents#style",
        "com_gacalevents.form#style",
        "com_gacalevents.item#style",
