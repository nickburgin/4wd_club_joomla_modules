{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "com_gacalevents",
  "version": "3.0.0",
  "description": "This file contains details of the assets used by the Events Calendar component by Glenn Arkell.",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "com_gacalevents.gacalevents",
