<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" hint="COM_GACALEVENTS_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="date_fr"
			type="calendar"
			label="COM_GACALEVENTS_FILTER_DATEFR"
			hint="COM_GACALEVENTS_FILTER_DATEFR"
			description="COM_GACALEVENTS_FILTER_DATEFR_DESC"
			onchange="this.form.submit();" />

		<field name="date_to"
			type="calendar"
			label="COM_GACALEVENTS_FILTER_DATETO"
			hint="COM_GACALEVENTS_FILTER_DATETO"
			description="COM_GACALEVENTS_FILTER_DATETO_DESC"
			onchange="this.form.submit();" />

    </fields>
    <fields name="extrainfo">

		<field name="note1" type="note" class="alert-info"
            label="COM_GACALEVENTS_FILTER_DATEFR_DESC" />

    </fields>
    <fields name="list">

       <field name="limit"
               type="limitbox"
               label="COM_GACALEVENTS_LIST_LIMIT"
               description="COM_GACALEVENTS_LIST_LIMIT_DESC"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>
</form>