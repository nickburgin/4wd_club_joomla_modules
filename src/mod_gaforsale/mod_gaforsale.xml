<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.4" client="site" method="upgrade">
	<name>MOD_GAFORSALE</name>
	<author>Glenn Arkell</author>
	<authorEmail>glenn@glennarkell.com.au</authorEmail>
	<authorUrl>http://www.glennarkell.com.au</authorUrl>
    <packager>Nick Burgin</packager>
	<copyright>Open Source</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<creationDate>04 March 2016</creationDate>
	<version>3.0.09</version>
	<description>Display Items</description>

    <compatibility>
        <include>
            <versions from="3.0.0" to="3.9.99" />
        </include>
        <exclude>
            <versions from="4.0.0">Not ready yet</versions>
        </exclude>
    </compatibility>

	<files>
		<filename module="mod_gaforsale">mod_gaforsale.php</filename>
		<filename>index.html</filename>
		<filename>mod_gaforsale.php</filename>
		<filename>mod_gaforsale.xml</filename>
		<filename>helper.php</filename>
		<folder>tmpl</folder>
    </files>

	<media destination="mod_gaforsale" folder="media">
		<filename>index.html</filename>
		<folder>css</folder>
		<folder>images</folder>
		<folder>fonts</folder>
		<folder>js</folder>
	</media>

	<languages>
		<language tag="en-GB">language/en-GB/en-GB.mod_gaforsale.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.mod_gaforsale.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">				
				<field name="disp_fsitems" type="radio" default="0"
                    class="btn-group btn-group-yesno" filter="int"
					label="MOD_GAFORSALE_FIELD_DISP_FSITEMS_LABEL"
					description="MOD_GAFORSALE_FIELD_DISP_FSITEMS_DESC" >
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>

			</fieldset>

			<fieldset name="advanced">
				<field name="layout" type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					description="JFIELD_ALT_MODULE_LAYOUT_DESC" />

				<field name="moduleclass_sfx" type="text"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />

				<field name="cache" type="list" default="1"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					description="COM_MODULES_FIELD_CACHING_DESC">
					<option value="1">JGLOBAL_USE_GLOBAL</option>
					<option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>

				<field name="cache_time" type="text" default="900"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					description="COM_MODULES_FIELD_CACHE_TIME_DESC" />

				<field name="cachemode" type="hidden" default="static">
					<option value="static"></option>
				</field>

			</fieldset>
		</fields>
	</config>

</extension>
