<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter" addfieldprefix="GlennArkell\Component\Gatracklog\Administrator\Field">
		<field name="search" type="text" description="COM_GATRACKLOG_SEARCH_FILTER_SUBMIT"
			label="COM_USERS_FILTER_SEARCH_DESC"
			class="js-stools-search-string" />

		<field name="state"
			type="status"
			label="COM_GATRACKLOG_FILTER_STATE"
			description="COM_GATRACKLOG_FILTER_STATE_DESC"
			onchange="this.form.submit();" >
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>

		<field name="rating" type="category" extension="com_gatracklog"
			onchange="this.form.submit();"
			label="COM_GATRACKLOG_FORM_LBL_TRACKLOG_RATING"
			description="COM_GATRACKLOG_FORM_DESC_TRACKLOG_RATING" />

		<field name="track_zone" type="category" extension="com_gatracklog.track_zone"
			onchange="this.form.submit();"
			label="COM_GATRACKLOG_FORM_LBL_TRACKLOG_TRACK_ZONE"
			description="COM_GATRACKLOG_FORM_DESC_TRACKLOG_TRACK_ZONE" />

		<field name="season_close" type="category" extension="com_gatracklog.season_close"
			onchange="this.form.submit();"
			label="COM_GATRACKLOG_FORM_LBL_TRACKLOG_SEASON_CLOSE"
			description="COM_GATRACKLOG_FORM_DESC_TRACKLOG_SEASON_CLOSE" />


	</fields>

	<fields name="list">

		<field name="limit"
			type="limitbox"
			class="input-mini"
			default="25"
			onchange="this.form.submit();" />

	</fields>

</form>