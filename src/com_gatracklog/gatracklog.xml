<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_gatracklog</name>
    <creationDate>2021-01-29</creationDate>
    <copyright>2021 Glenn Arkell</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <author>Glenn Arkell</author>
    <authorEmail>glenn@glennarkell.com.au</authorEmail>
    <authorUrl>https://www.glennarkell.com.au</authorUrl>
    <packager>Nick Burgin</packager>
    <version>4.2.0</version>
    <description>COM_GATRACKLOG_XML_DESCRIPTION</description>

    <namespace path="src">GlennArkell\Component\Gatracklog</namespace>

    <scriptfile>script.php</scriptfile>
    
    <install> <!-- Runs on install -->
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <update> <!-- Runs on update -->
		<schemas>
			<schemapath type="mysql">sql/updates/mysql/</schemapath>
		</schemas>
    </update>
    <uninstall> <!-- Runs on uninstall -->
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>

    <files folder="site">
        <folder>forms</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <media destination="com_gatracklog" folder="media">
        <folder>css</folder>
        <folder>images</folder>
        <file>joomla.asset.json</file>
    </media>
    <languages folder="site">
			<language tag="en-GB">language/en-GB/com_gatracklog.ini</language>
    </languages>
    <administration>
        <menu img="class:fa fa-settings" >COM_GATRACKLOG<params><dashboard>gatracklog</dashboard></params></menu>

        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <folder>forms</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>services</folder>
            <folder>presets</folder>
            <folder>sql</folder>
        </files>
        <languages folder="administrator/language">
			<language tag="en-GB">en-GB/com_gatracklog.ini</language>
			<language tag="en-GB">en-GB/com_gatracklog.sys.ini</language>
			<language tag="en-GB">en-GB/guidedtours.gatracklog_configuration.ini</language>
			<language tag="en-GB">en-GB/guidedtours.gatracklog_menu.ini</language>
			<language tag="en-GB">en-GB/guidedtours.gatracklog_tracklog.ini</language>
			<language tag="en-GB">en-GB/guidedtours.gatracklog_welcome.ini</language>
        </languages>
    </administration>

	<dashboards>
		<dashboard title="COM_GATRACKLOG_DASHBOARD_TITLE" icon="icon-none fa fa-settings">
			COM_GATRACKLOG_DASHBOARD_TITLE
		</dashboard>
	</dashboards>


	<updateservers>
		<server type="extension" priority="1" name="Tracklog System">https://github.com/nickburgin/4wd_club_joomla_modules/releases/latest/download/com_gatracklog-update.xml</server>
	</updateservers>

</extension>
