<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" hint="COM_GAMERCHANDISE_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="status"
               label="COM_GAMERCHANDISE_FILTER_STATE"
               description="COM_GAMERCHANDISE_FILTER_STATE_DESC"
               onchange="this.form.submit();" >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field name="cat_id" type="category" extension="com_gamerchandise" 
			label="COM_GAMERCHANDISE_FORM_LBL_PRODUCT_CAT_ID"
			show_root="1" onchange="this.form.submit();"/>

		<field name="gender" type="list" onchange="this.form.submit();" 
			label="COM_GAMERCHANDISE_FORM_LBL_PRODUCT_GENDER"
			default="COM_GAMERCHANDISE_PRODUCTS_GENDER_FILTER">
		    <option value="0">GAGENDER_UNISEX</option>
		    <option value="1">GAGENDER_MENS</option>
		    <option value="2">GAGENDER_LADIES</option>
		</field>


    </fields>

    <fields name="list">

        <field name="limit"
               type="limitbox"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>