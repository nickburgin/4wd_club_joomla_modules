<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter" addfieldpath="GlennArkell\Component\Gatripsys\Administrator\Field">
        <field name="search" type="text" hint="COM_GATRIPSYS_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="list"
               label="COM_GATRIPSYS_FILTER_STATE"
               description="COM_GATRIPSYS_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="0">JOPTION_SELECT_PUBLISHED</option>
            <option value="1">GAUNPAID</option>
            <option value="3">GAREFUNDED</option>
            <option value="2">GAPAID</option>
            <option value="-2">GACANCELLED</option>
        </field>

    </fields>

	<fields name="list">

		<field name="limit"
			type="limitbox"
			class="input-mini"
			default="25"
			onchange="this.form.submit();" />

	</fields>

</form>