<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="sysinfo" addfieldprefix="GlennArkell\Component\Gatripsys\Administrator\Field">
		<field name="id" type="text" readonly="true" class="readonly" default="0" label="COM_GATRIPSYS_FORM_LBL_ID" description="COM_GATRIPSYS_FORM_DESC_ID"/>
		<field name="ordering" label="COM_GATRIPSYS_FORM_LBL_ORDERING" description="COM_GATRIPSYS_FORM_DESC_ORDERING"/>
		<field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="checked_out" type="hidden" filter="unset"/>
		<field name="checked_out_time" type="hidden" filter="unset"/>
	    <field name="created_by" type="Createdby" hidden="true" default="0" label="COM_GATRIPSYS_FORM_LBL_CREATED_BY" description="COM_GATRIPSYS_FORM_DESC_CREATED_BY" hint="COM_GATRIPSYS_FORM_LBL_CREATED_BY"/>
	    <field name="modified_by" type="Modifiedby" hidden="true" default="0" label="COM_GATRIPSYS_FORM_LBL_MODIFIED_BY" description="COM_GATRIPSYS_FORM_DESC_MODIFIED_BY" hint="COM_GATRIPSYS_FORM_LBL_MODIFIED_BY"/>
	    <field name="created_date" type="Timecreated" label="COM_GATRIPSYS_FORM_LBL_CREATED_DATE" description="COM_GATRIPSYS_FORM_DESC_CREATED_DATE" hint="COM_GATRIPSYS_FORM_LBL_CREATED_DATE"/>
	    <field name="modified_date" type="Timeupdated" label="COM_GATRIPSYS_FORM_LBL_MODIFIED_DATE" description="COM_GATRIPSYS_FORM_DESC_MODIFIED_DATE" hint="COM_GATRIPSYS_FORM_LBL_MODIFIED_DATE"/>
	</fieldset>

	<fieldset name="general" addfieldprefix="GlennArkell\Component\Gatracklog\Administrator\Field">

        <field name="trip_id" type="Trips" readonly="true" class="input-xxlarge readonly"
            label="COM_GATRIPSYS_FORM_LBL_ATTENDEE_TRIP_ID"
            description="COM_GATRIPSYS_FORM_DESC_ATTENDEE_TRIP_ID" />
    
        <field name="user_id" type="Members"
            label="COM_GATRIPSYS_FORM_LBL_ATTENDEE_USER_ID"
            description="COM_GATRIPSYS_FORM_DESC_ATTENDEE_USER_ID" />

        <field name="user_name" type="text" readonly="true" class="readonly"
            label="COM_GATRIPSYS_FORM_LBL_ATTENDEE_USER_ID"
            description="COM_GATRIPSYS_FORM_DESC_ATTENDEE_USER_ID" />

        <field name="approved_by" type="Approvers"
            label="COM_GATRIPSYS_FORM_LBL_ATTENDEE_APPROVED_BY"
            description="COM_GATRIPSYS_FORM_DESC_ATTENDEE_APPROVED_BY" />

        <field name="in_party" type="text" default="2"
            label="COM_GATRIPSYS_FORM_LBL_ATTENDEE_IN_PARTY"
            description="COM_GATRIPSYS_FORM_DESC_ATTENDEE_IN_PARTY" />
    
        <field name="from_modal" type="hidden" default="0" />
    
	</fieldset>

	<fieldset name="emailinfo">

	    <field name="news_subject" class="input-xxlarge" filter="safehtml" type="text"
			label="COM_GATRIPSYS_FORM_LBL_TRIP_NEWS_SUBJECT"
			description="COM_GATRIPSYS_FORM_DESC_TRIP_NEWS_SUBJECT"
			hint="COM_GATRIPSYS_FORM_DESC_TRIP_NEWS_SUBJECT"/>

	    <field name="news_detail" editor="|" buttons="true" filter="safehtml" type="editor"
			label="COM_GATRIPSYS_FORM_LBL_TRIP_NEWS_DETAIL"
			description="COM_GATRIPSYS_FORM_DESC_TRIP_NEWS_DETAIL"
			hint="COM_GATRIPSYS_FORM_LBL_TRIP_NEWS_DETAIL"/>

	</fieldset>

	<fieldset name="other">
		<field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
	</fieldset>
	<fieldset name="extrainfo">
		<field name="comment" filter="safehtml" type="textarea" rows="2" label="COM_GATRIPSYS_FORM_LBL_COMMENT" description="COM_GATRIPSYS_FORM_DESC_COMMENT" hint="COM_GATRIPSYS_FORM_LBL_COMMENT"/>
	</fieldset>
</form>
