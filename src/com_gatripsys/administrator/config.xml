			label="COM_GATRIPSYS_TMPL_EMAIL_LABEL"
			description="COM_GATRIPSYS_TMPL_EMAIL_DESC">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

    </fieldset>
</config>
