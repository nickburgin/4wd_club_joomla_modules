			label="COM_GATRIPSYS_FIELD_BLOCK_REGBY_LABEL"
			description="COM_GATRIPSYS_FIELD_BLOCK_REGBY_DESC" >
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field name="show_comment" type="radio" default="0"
