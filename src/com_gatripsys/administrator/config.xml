			description="COM_GATRIPSYS_FIELD_SHOW_COMMENT_DESC" >
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field name="restrict_leader" type="radio" default="0"
			layout="joomla.form.field.radio.switcher"
			label="COM_GATRIPSYS_FIELD_RESTRICT_LEADER_LABEL"
			description="COM_GATRIPSYS_FIELD_RESTRICT_LEADER_DESC" >
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

        <field name="leader_gp" type="usergrouplist" showon="restrict_leader:1" class="input-xlarge"
            label="COM_GATRIPSYS_FIELD_LEADER_GP_LABEL"
            description="COM_GATRIPSYS_FIELD_LEADER_GP_DESC" />

		<field name="incl_email" type="radio" default="0"
			layout="joomla.form.field.radio.switcher"
			label="COM_GATRIPSYS_FIELD_INCL_EMAIL_LABEL"
			description="COM_GATRIPSYS_FIELD_INCL_EMAIL_DESC" >
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field name="show_editor" type="radio" default="0"
			layout="joomla.form.field.radio.switcher"
			label="COM_GATRIPSYS_FIELD_SHOW_EDITOR_LABEL"
			description="COM_GATRIPSYS_FIELD_SHOW_EDITOR_DESC" >
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

        <field name="editor_gp" type="usergrouplist" showon="show_editor:1"
            label="COM_GATRIPSYS_FIELD_EDITOR_GP_LABEL"
            description="COM_GATRIPSYS_FIELD_EDITOR_GP_DESC" />
    
        <field name="safe_files" type="list" class="multiple" multiple="true"
             label="COM_GATRIPSYS_SAFE_FILES_LABEL"
             description="COM_GATRIPSYS_SAFE_FILES_DESC">
                 <option value="pdf">pdf</option>
                 <option value="jpg">jpg</option>
                 <option value="png">png</option>
                 <option value="gif">gif</option>
        </field>

        <field name="tripplan_dir" type="text" default="images/trips/trip_plans"
             label="COM_GATRIPSYS_TRIPPLAN_DIR_LABEL"
             description="COM_GATRIPSYS_TRIPPLAN_DIR_DESC" />

        <field name="tripimg_dir" type="text" default="images/trips/trip_images"
             label="COM_GATRIPSYS_TRIPIMG_DIR_LABEL"
             description="COM_GATRIPSYS_TRIPIMG_DIR_DESC" />

		<field name="delete_file" type="radio" default="0"
			layout="joomla.form.field.radio.switcher"
			label="COM_GATRIPSYS_FIELD_DELETE_FILE_LABEL"
			description="COM_GATRIPSYS_FIELD_DELETE_FILE_DESC" >
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

    </fieldset>

    <fieldset name="permissions"
              description="JCONFIG_PERMISSIONS_DESC"
              label="JCONFIG_PERMISSIONS_LABEL">

        <field name="rules" type="rules" component="com_gatripsys"
               class="inputbox" filter="rules" validate="rules"
               label="JCONFIG_PERMISSIONS_LABEL"
               section="component"
        />
	</fieldset>

    <fieldset name="component" label="COM_GATRIPSYS_INTEGRATION_LABEL">

        <field name="save_history"
               type="radio"
			layout="joomla.form.field.radio.switcher"
               default="0"
               label="JGLOBAL_SAVE_HISTORY_OPTIONS_LABEL"
               description="JGLOBAL_SAVE_HISTORY_OPTIONS_DESC" >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="history_limit"
               type="text"
               filter="integer"
               label="JGLOBAL_HISTORY_LIMIT_OPTIONS_LABEL"
               description="JGLOBAL_HISTORY_LIMIT_OPTIONS_DESC"
               default="5" showon="save_history:1"
        />

        <field name="log_actions" type="radio" default="0"
			layout="joomla.form.field.radio.switcher"
             label="COM_GATRIPSYS_LOG_ACTIONS_LABEL"
             description="COM_GATRIPSYS_LOG_ACTIONS_DESC">
                 <option value="0">JNO</option>
                 <option value="1">JYES</option>
        </field>

        <field name="test_switch" type="radio" default="0"
			layout="joomla.form.field.radio.switcher"
             label="COM_GATRIPSYS_TEST_SWITCH_LABEL"
             description="COM_GATRIPSYS_TEST_SWITCH_DESC">
                 <option value="0">JNO</option>
                 <option value="1">JYES</option>
        </field>

        <field name="tmpl_email" type="radio" default="0"
