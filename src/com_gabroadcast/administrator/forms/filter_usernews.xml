<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" hint="COM_GABROADCAST_SEARCH_FILTER_SUBMIT"
            label="COM_USERS_FILTER_SEARCH_DESC"
            class="js-stools-search-string" />

        <field name="state"
            type="list"
            label="COM_GABROADCAST_FILTER_STATE"
            description="COM_GABROADCAST_FILTER_STATE_DESC"
            onchange="this.form.submit();" >
	        <option value="1">JPUBLISHED</option>
	        <option value="0">JUNPUBLISHED</option>
	        <option value="2">JARCHIVED</option>
	        <option value="-2">JTRASHED</option>
            <option value="5">Pending</option>
            <option value="6">Pending Sent</option>
        </field>

        <field name="cat_id" type="category" extension="com_gabroadcast"
			onchange="this.form.submit();" default=""
			label="COM_GABROADCAST_FORM_LBL_USERNEW_CAT_ID"  >
			<option value=""/>
			<option value="">JOPTION_SELECT_CATEGORY</option>
		</field>

    </fields>

    <fields name="list">

        <field name="limit"
            type="limitbox"
            class="input-mini"
            default="25"
            onchange="this.form.submit();" />

    </fields>

</form>