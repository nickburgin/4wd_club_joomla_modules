<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="sysinfo" addfieldprefix="GlennArkell\Component\Gabroadcast\Administrator\Field">
	    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
	    <field name="ordering"/>
	    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
			<option value="5">Pending</option>
			<option value="6">Pending Sent</option>
	    </field>
	    <field name="checked_out" type="hidden" filter="unset"/>
	    <field name="checked_out_time" default="0000-00-00 00:00:00" type="hidden" filter="unset"/>
	    <field name="created_by" type="Createdby" default="0" label="COM_GABROADCAST_FORM_LBL_CREATED_BY" description="COM_GABROADCAST_FORM_DESC_CREATED_BY" hidden="true" hint="COM_GABROADCAST_FORM_LBL_CREATED_BY"/>
	    <field name="modified_by" type="Modifiedby" default="0" label="COM_GABROADCAST_FORM_LBL_MODIFIED_BY" description="COM_GABROADCAST_FORM_DESC_MODIFIED_BY" hidden="true" hint="COM_GABROADCAST_FORM_LBL_MODIFIED_BY"/>
	    <field name="created_date" type="Timecreated" label="COM_GABROADCAST_FORM_LBL_CREATED_DATE" description="COM_GABROADCAST_FORM_DESC_CREATED_DATE" hint="COM_GABROADCAST_FORM_LBL_CREATED_DATE"/>
	    <field name="modified_date" type="Timecreated" label="COM_GABROADCAST_FORM_LBL_MODIFIED_DATE" description="COM_GABROADCAST_FORM_DESC_MODIFIED_DATE" hint="COM_GABROADCAST_FORM_LBL_MODIFIED_DATE"/>
	</fieldset>

	<fieldset name="details" addfieldprefix="GlennArkell\Component\Gabroadcast\Administrator\Field">
	    <field name="cat_id" extension="com_gabroadcast" type="category" label="COM_GABROADCAST_FORM_LBL_USERNEW_CAT_ID" description="COM_GABROADCAST_FORM_DESC_USERNEW_CAT_ID" hint="COM_GABROADCAST_FORM_LBL_USERNEW_CAT_ID"/>
	    <field name="fin_users_only" default="0" type="radio" class="btn-group btn-group-yesno" label="COM_GABROADCAST_FORM_LBL_USERNEW_FIN_USERS_ONLY" description="COM_GABROADCAST_FORM_DESC_USERNEW_FIN_USERS_ONLY" hint="COM_GABROADCAST_FORM_LBL_USERNEW_FIN_USERS_ONLY">
		    <option value="0">JNO</option>
		    <option value="1">JYES</option>
	    </field>
	    <field name="news_subject" filter="safehtml" type="text" required="true" label="COM_GABROADCAST_FORM_LBL_USERNEW_NEWS_SUBJECT" description="COM_GABROADCAST_FORM_DESC_USERNEW_NEWS_SUBJECT" hint="COM_GABROADCAST_FORM_LBL_USERNEW_NEWS_SUBJECT"/>
	    <field name="news_detail" editor="|" buttons="true" filter="ComponentHelper::filterText" type="editor" label="COM_GABROADCAST_FORM_LBL_USERNEW_NEWS_DETAIL" description="COM_GABROADCAST_FORM_DESC_USERNEW_NEWS_DETAIL" hint="COM_GABROADCAST_FORM_LBL_USERNEW_NEWS_DETAIL"/>
		<field name="attach_file" type="text" class="input-xxlarge" description="COM_GABROADCAST_FORM_DESC_USERNEW_ATTACHFILE" label="COM_GABROADCAST_FORM_LBL_USERNEW_ATTACHFILE" />
	</fieldset>

	<fieldset name="extrainfo">
	    <field name="comment" editor="|" buttons="true" filter="ComponentHelper::filterText" type="editor" label="COM_GABROADCAST_FORM_LBL_COMMENT" description="COM_GABROADCAST_FORM_DESC_COMMENT" hint="COM_GABROADCAST_FORM_LBL_COMMENT"/>
	    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
	    <field name="pending_bcast" type="textarea" class="readonly" readonly="true" rows="2" label="COM_GABROADCAST_FORM_LBL_USERNEW_PENDING_DETAIL" description="COM_GABROADCAST_FORM_DESC_USERNEW_PENDING_DETAIL"/>
	</fieldset>
</form>
