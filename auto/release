#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

BUILD_NUMBER="${BUILD_NUMBER:-$(date +%Y%m%d%H%M%S)}"
TAG="build-${BUILD_NUMBER}"
COMMIT="${BUILDKITE_COMMIT:-$(git rev-parse HEAD)}"

gh release create "$TAG" \
    --title "Build ${BUILD_NUMBER}" \
    --notes "Automated build ${BUILD_NUMBER} (${COMMIT})" \
    dist/*.zip
