#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

mkdir -p dist/
buildkite-agent artifact download "dist/*.zip" dist/

# Build list of tags to check
tags=()
names=()
versions=()
for zip in dist/*.zip; do
    filename=$(basename "$zip")
    name="${filename%-*}"
    version="${filename##*-}"; version="${version%.zip}"
    tags+=("${name}-${version}")
    names+=("$name")
    versions+=("$version")
done

# Check which tags already exist in a single container invocation
existing_tags=$(docker-compose run --rm --no-deps \
    -e GH_TOKEN="${GH_TOKEN:-${GITHUB_ACCESS_TOKEN:-}}" \
    build bash -c '
        for tag in "$@"; do
            gh release view "$tag" &>/dev/null && echo "$tag"
        done
    ' -- "${tags[@]}")

echo "steps:" > /tmp/release-pipeline.yml
needs_release=0

for i in "${!tags[@]}"; do
    tag="${tags[$i]}"
    name="${names[$i]}"
    version="${versions[$i]}"

    if echo "$existing_tags" | grep -qx "$tag"; then
        echo "  ${name} ${version} already released, skipping."
    else
        needs_release=1
        cat >> /tmp/release-pipeline.yml <<EOF
  - label: "Release ${name}"
    command: ./auto/release-ext ${name}
    branches: main
EOF
    fi
done

if [ "$needs_release" -eq 1 ]; then
    cat >> /tmp/release-pipeline.yml <<'EOF'

  - wait

  - label: "Publish Update XMLs"
    command: ./auto/publish-update-xmls
    branches: main
EOF
else
    echo "  All extensions already released, skipping publish step."
    cat >> /tmp/release-pipeline.yml <<'EOF'
  - label: "Nothing to release"
    command: echo "All extensions already released."
    branches: main
EOF
fi

buildkite-agent pipeline upload /tmp/release-pipeline.yml
